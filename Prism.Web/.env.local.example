# Copy this file to .env.local and fill in the values once the Entra External ID
# App Registration and Google federation are configured in the Azure portal.
# NEVER commit .env.local — it is already in .gitignore.

# Entra External ID App Registration (CIAM tenant)
VITE_AZURE_CLIENT_ID=YOUR_APP_REGISTRATION_CLIENT_ID_HERE

# For CIAM tenants, authority = https://<tenant-subdomain>.ciamlogin.com/<tenant-id>
VITE_AZURE_AUTHORITY=https://YOUR_TENANT_SUBDOMAIN.ciamlogin.com/YOUR_TENANT_ID

# Redirect URI must match one of the URIs registered in the App Registration
VITE_AZURE_REDIRECT_URI=http://localhost:7000
