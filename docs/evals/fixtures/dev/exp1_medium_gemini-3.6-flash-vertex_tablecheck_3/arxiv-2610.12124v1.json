      "label": "partially_supported",
      "claim_summary": "Unused details recede naturally without explicit importance scores or decay rules.",
      "missing": false,
      "grounding_status": "Pass",
      "claim_text_verbatim": "Experience that remains unused continues to recede in detail through recursive consolidation, without separately assigned importance scores or time-based forgetting rules.",
      "evidence_spans": [
        {
          "source_text": "These thresholds control when context is consolidated, rather than assigning importance or decay scores to individual memories.",
          "source_section": "Table 5",
          "grounding_status": "Partial",
          "stance": "supports"
        },
        {
          "source_text": "Meanwhile, an ordinary remotecontrol episode is first retained with its destination, then reduced to an item in a list of completed tasks, after which its episode-specific details no longer occur in the narrative.",
          "source_section": "Section A.7",
          "grounding_status": "Partial",
          "stance": "supports"
        },
        {
          "source_text": "Most items without detected use remain unchanged (95.8%), so these adjacent-consolidation statistics do not establish general fading of unused knowledge.",
          "source_section": "Section A.6",
          "grounding_status": "Pass",
          "stance": "refutes"
        }
      ],
      "audit_model_served": "gemini-3.6-flash",
