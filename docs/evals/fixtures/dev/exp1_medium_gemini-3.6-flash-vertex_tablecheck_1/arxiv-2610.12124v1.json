      "index": 6,
      "label": "supported",
      "claim_summary": "Unused details recede naturally without explicit importance scores or decay rules.",
      "missing": false,
      "grounding_status": "Pass",
      "claim_text_verbatim": "Experience that remains unused continues to recede in detail through recursive consolidation, without separately assigned importance scores or time-based forgetting rules.",
      "evidence_spans": [
        {
          "source_text": "These thresholds control when context is consolidated, rather than assigning importance or decay scores to individual memories.",
          "source_section": "Appendix A",
          "grounding_status": "Pass",
          "stance": "supports"
        },
        {
          "source_text": "Meanwhile, details of a routine placement episode recede through recursive consolidation (Fig. 7).",
          "source_section": "Section 5.2",
          "grounding_status": "Pass",
          "stance": "supports"
        },
        {
          "source_text": "an ordinary remotecontrol episode is first retained with its destination, then reduced to an item in a list of completed tasks, after which its episode-specific details no longer occur in the narrative.",
          "source_section": "Appendix A.7",
          "grounding_status": "Pass",
          "stance": "supports"
        }
      ],
